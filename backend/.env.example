# Copy to backend/.env — ONLY needed when running the backend on the host
# (unsupported path: requires Python 3.12; the normal workflow is Docker, which
#  uses the root .env via docker-compose instead)

DATABASE_URL=postgresql+asyncpg://socialhub:devpassword@localhost:5432/socialhub

JWT_SECRET_KEY=change-me-dev-only
JWT_REFRESH_SECRET_KEY=change-me-dev-only-2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000

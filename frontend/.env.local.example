# Copy to frontend/.env.local

# Browser → backend (only for direct calls; most traffic goes through the Next proxy route)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Next.js route handlers / server components → backend.
# Host dev: localhost. Inside Docker Compose this is overridden to http://backend:8000/api/v1
API_INTERNAL_URL=http://localhost:8000/api/v1

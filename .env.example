# Copy to .env — consumed by docker-compose (postgres + backend services)

# PostgreSQL
POSTGRES_USER=socialhub
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=socialhub

# Backend — inside the Docker network the DB host is the service name `postgres`
DATABASE_URL=postgresql+asyncpg://socialhub:devpassword@postgres:5432/socialhub

# JWT — generate real secrets for any non-local deployment (openssl rand -hex 32)
JWT_SECRET_KEY=change-me-dev-only
JWT_REFRESH_SECRET_KEY=change-me-dev-only-2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
